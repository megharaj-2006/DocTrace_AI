# Application Configuration
APP_ENV=development
SERVICE_NAME=doctrace-ai-service
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Temporary File Directory (leave blank for system default temp dir)
TEMP_DIR=

# Use qdrant for the compose deployment; mock is useful for isolated tests.
VECTOR_STORE_BACKEND=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=invoice_page_embeddings_v1
SIMILARITY_THRESHOLD=0.955
